{
  "name": "dead-souls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that tracks per-user messaging activity in a private group",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop dead-souls",
    "pm2:logs": "pm2 logs dead-souls",
    "pm2:status": "pm2 status dead-souls"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.44.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
