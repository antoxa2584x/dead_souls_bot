# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Default interface language: uk | en
# Each group can override this from /settings.
DEFAULT_LANG=uk

# Where the SQLite file lives
DB_PATH=./data/dead_souls.db

# IANA timezone used to bucket messages into days and hours.
# Changing this later does NOT rewrite already-recorded rows.
TZ_NAME=Europe/Kyiv

# A member with no message for this many days shows up in /dead.
# Each group can override this from /settings.
DEAD_AFTER_DAYS=14

# Optional: comma-separated chat ids the bot will record.
# Leave empty to record every group it is added to.
ALLOWED_CHAT_IDS=

# Optional: comma-separated user ids treated as bot admins everywhere.
# Group administrators can already change settings without being listed here.
ADMIN_USER_IDS=
